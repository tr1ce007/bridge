# Copy to .env.local and fill in. Without these the site works in local/demo mode.

# Supabase project URL (Project settings > API). Both Supabase variables set = Supabase mode.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key. Safe for the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key. SERVER ONLY, bypasses RLS: used for ai_failures and analytics_events writes (trackEvent). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Which AI provider answers: anthropic | openai | demo. Leave empty for automatic choice:
# anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set, else demo.
# A named provider without its key also falls back to demo.
AI_PROVIDER=
# Anthropic API key (server only).
ANTHROPIC_API_KEY=
# Anthropic model name used for the questionnaire, report and chat.
ANTHROPIC_MODEL=claude-sonnet-5-5
# API key for an OpenAI-compatible provider (server only).
OPENAI_API_KEY=
# Base URL of the OpenAI-compatible API, e.g. https://api.openai.com/v1 (leave empty for the default).
OPENAI_BASE_URL=
# Model name for the OpenAI-compatible provider.
OPENAI_MODEL=

# Set to "true" to show the "Sign in with Google" button (enable the Google provider in Supabase first).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Reddit API client id for the optional story-search script (npm run discover; create an app at reddit.com/prefs/apps).
REDDIT_CLIENT_ID=
# Reddit API client secret for the same script (server/script only).
REDDIT_CLIENT_SECRET=

# Max AI requests per minute per visitor and route (in-memory, per server process; default 10).
RATE_LIMIT_PER_MINUTE=10
